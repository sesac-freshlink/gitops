    {
      "type": "table",
      "title": "API별 요청 (선택한 기간 합계)",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "서비스·메서드·URI·상태 코드별 요청 수와 평균 응답 시간",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "sum by (job, method, uri, status) (increase(http_server_requests_seconds_count{namespace=\"freshlink\", job=~\"$service\", uri!~\"/actuator.*\"}[$__range]))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "sum by (job, method, uri, status) (increase(http_server_requests_seconds_sum{namespace=\"freshlink\", job=~\"$service\", uri!~\"/actuator.*\"}[$__range])) / sum by (job, method, uri, status) (increase(http_server_requests_seconds_count{namespace=\"freshlink\", job=~\"$service\", uri!~\"/actuator.*\"}[$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "job": "서비스",
              "method": "메서드",
              "uri": "URI",
              "status": "상태",
              "Value #A": "요청 수",
              "Value #B": "평균 응답(초)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "요청 수",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "요청 수"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
