{
  "uid": "freshlink-aws",
  "title": "FreshLink AWS (CloudWatch)",
  "tags": [
    "freshlink",
    "aws"
  ],
  "description": "RDS·SQS·ALB·CloudFront 지표. CloudWatch에서 읽는다(조회할 때마다 GetMetricData 요금). 새로 고침 5분.",
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "timepicker": {
    "refresh_intervals": [
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(freshlink_env_info, env)",
          "refId": "env"
        },
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "description": "이 Grafana가 떠 있는 클러스터의 환경(gitops가 Prometheus 기록 규칙 freshlink_env_info로 넣는다)"
      },
      {
        "name": "queue",
        "label": "큐",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "query": {
          "refId": "queue",
          "region": "ap-northeast-2",
          "namespace": "AWS/SQS",
          "metricName": "ApproximateNumberOfMessagesVisible",
          "dimensionKey": "QueueName",
          "instanceID": "",
          "attributeName": "",
          "resourceType": "",
          "queryType": "dimensionValues"
        },
        "regex": "/^${env}-(inventory-commands|inventory-results|notification-events)(\\.fifo)?$/",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "dlq",
        "label": "DLQ",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "query": {
          "refId": "dlq",
          "region": "ap-northeast-2",
          "namespace": "AWS/SQS",
          "metricName": "ApproximateNumberOfMessagesVisible",
          "dimensionKey": "QueueName",
          "instanceID": "",
          "attributeName": "",
          "resourceType": "",
          "queryType": "dimensionValues"
        },
        "regex": "/^${env}-(inventory-commands|inventory-results|notification-events)-dlq(\\.fifo)?$/",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "alb",
        "label": "ALB",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "query": {
          "refId": "alb",
          "region": "ap-northeast-2",
          "namespace": "",
          "metricName": "",
          "dimensionKey": "",
          "instanceID": "",
          "attributeName": "",
          "resourceType": "elasticloadbalancing:loadbalancer",
          "queryType": "resourceARNs",
          "tags": {
            "elbv2.k8s.aws/cluster": [
              "freshlink-${env}-eks"
            ]
          }
        },
        "regex": "/loadbalancer\\/(app\\/.+)$/",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "cf",
        "label": "CloudFront",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "query": {
          "refId": "cf",
          "region": "us-east-1",
          "namespace": "",
          "metricName": "",
          "dimensionKey": "",
          "instanceID": "",
          "attributeName": "",
          "resourceType": "cloudfront:distribution",
          "queryType": "resourceARNs",
          "tags": {
            "Project": [
              "freshlink"
            ],
            "Environment": [
              "${env}"
            ]
          }
        },
        "regex": "/distribution\\/(.+)$/",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SQS 쪽지 (큐 3개 + DLQ 3개)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
